# ----- Application -----
PORT=3000
NODE_ENV=development

# ----- Database (PostgreSQL) -----
DB_HOST=localhost
DB_PORT=5432
DB_USERNAME=postgres
DB_PASSWORD=postgres
DB_NAME=simple_invoice
# Auto-create schema from entities on boot (use only for dev/assessment)
DB_SYNCHRONIZE=true

# ----- JWT -----
JWT_SECRET=change-me-to-a-long-random-secret
# Access token lifetime in seconds (default 3600)
JWT_EXPIRES_IN=3600

# ----- Seed (default reviewer account) -----
SEED_USER_EMAIL=admin@101digital.io
SEED_USER_PASSWORD=Password123!
SEED_USER_FULLNAME=Reviewer Admin

# ----- CORS -----
# Comma-separated list of allowed origins for the frontend
CORS_ORIGIN=http://localhost:5173
