# ============================================================================
#  Root environment for docker-compose. Copy to `.env` to override defaults:
#      cp .env.example .env
#  Every value has a sensible default in docker-compose.yml, so `docker compose
#  up` works even without this file. Never commit a real `.env`.
# ============================================================================

# ----- Database -----
DB_USERNAME=postgres
DB_PASSWORD=postgres
DB_NAME=simple_invoice
# Docker uses migrations (not synchronize) for production-style schema management.
DB_SYNCHRONIZE=false
DB_RUN_MIGRATIONS=true
# Host port the database is published on (container always uses 5432).
DB_PUBLISH_PORT=5433

# ----- Backend -----
BACKEND_PUBLISH_PORT=3000
JWT_SECRET=change-me-to-a-long-random-secret
JWT_EXPIRES_IN=3600
RUN_SEED_ON_BOOT=true
CORS_ORIGIN=http://localhost:8080,http://localhost:5173

# Default reviewer account (created by the seed script).
SEED_USER_EMAIL=admin@101digital.io
SEED_USER_PASSWORD=Password123!
SEED_USER_FULLNAME=Reviewer Admin

# ----- Frontend -----
FRONTEND_PUBLISH_PORT=8080
# API base URL baked into the frontend build (the browser calls this).
VITE_API_BASE_URL=http://localhost:3000
